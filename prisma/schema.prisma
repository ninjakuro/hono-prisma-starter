generator client {
  provider = "prisma-client"
  output   = "../src/db/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  passhash  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
